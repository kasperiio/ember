{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/*.d.ts"]
}
